# Access log on stdout (docker-compose caps its size). Secrets and guest names never reach it: the calendar feed token in
# /api/ical/<token>.ics, the unsubscribe ?token=, the Authorization header and the refreshed JWT the backend
# returns in X-Refreshed-Token are replaced or dropped. Client IPs stay, for abuse investigations.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "(/api/ical/)[^/?]+|((?:token|name|q|search|email|guestName)=)[^&]+" "${1}${2}REDACTED"
				request>headers>Authorization delete
				request>headers>Cookie delete
				resp_headers>X-Refreshed-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

api.roomtrack.app {
	import access_log
	request_body {
		max_size 1MB
	}
	header {
		-Server
		-Via
		defer
	}
	reverse_proxy backend:8080 {
		header_down -Via
		header_down -Server
	}
}
