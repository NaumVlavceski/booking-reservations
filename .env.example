# Copy to .env next to docker-compose.yml and fill in. Placeholders only: never commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Secrets (at least 32 characters each; the backend refuses to start otherwise) ---
JWT_SECRET=change-me-to-64-random-hex-characters-change-me-to-64-random-hex
EMAIL_CODE_SECRET=change-me-to-another-64-random-hex-characters-change-me-to-other

# --- Sessions (milliseconds): idle timeout, absolute timeout, and when to renew (fraction of the idle timeout) ---
APP_JWT_IDLE_TIMEOUT_MS=1800000
APP_JWT_ABSOLUTE_TIMEOUT_MS=86400000
APP_JWT_RENEW_THRESHOLD_RATIO=0.5

# --- Public addresses (with https://) ---
FRONTEND_URL=https://roomtrack.app
PUBLIC_API_URL=https://api.roomtrack.app

# --- Email (Resend). MAIL_ENABLED must be true unless the backend runs with the "local" profile ---
MAIL_ENABLED=true
RESEND_API_KEY=
MAIL_FROM=RoomTrack <onboarding@resend.dev>
EMAIL_LOG_RETENTION_DAYS=90
# Where the contact form (roomtrack.app/contact) sends messages; replies go to the visitor. Stays on the server,
# never in the code or the website. Empty: the form says it is not available.
CONTACT_TO=

# --- API documentation (Swagger UI at /swagger-ui/index.html, spec at /v3/api-docs). Off unless true ---
APP_DOCS_ENABLED=false
APP_DOCS_SERVER_URL=https://api.roomtrack.app

# --- "Try the demo": each visitor gets a private sample account, deleted after 1 hour. Off unless true ---
APP_DEMO_ENABLED=false
