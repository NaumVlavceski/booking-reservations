# Copy to .env next to docker-compose.yml and fill in. Placeholders only: never commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Secrets (at least 32 characters each; the backend refuses to start otherwise) ---
JWT_SECRET=change-me-to-64-random-hex-characters-change-me-to-64-random-hex
EMAIL_CODE_SECRET=change-me-to-another-64-random-hex-characters-change-me-to-other

# --- Sessions (milliseconds): idle timeout, absolute timeout, and when to renew (fraction of the idle timeout) ---
APP_JWT_IDLE_TIMEOUT_MS=1800000
APP_JWT_ABSOLUTE_TIMEOUT_MS=86400000
APP_JWT_RENEW_THRESHOLD_RATIO=0.5

# --- Public addresses (with https://) ---
# PUBLIC_API_URL is required: the backend refuses to start without a full https address of the API (not localhost),
# because the links in emails are built from it (audit SEC-04 / BIZ-04). The local and test profiles are exempt.
FRONTEND_URL=https://roomtrack.app
PUBLIC_API_URL=https://api.roomtrack.app

# --- Email (Resend). MAIL_ENABLED must be true unless the backend runs with the "local" profile ---
MAIL_ENABLED=true
RESEND_API_KEY=
MAIL_FROM=RoomTrack <onboarding@resend.dev>
EMAIL_LOG_RETENTION_DAYS=90
# Newer name for the same setting (wins over EMAIL_LOG_RETENTION_DAYS when set)
APP_EMAIL_LOG_RETENTION_DAYS=90
# Resend webhook signing secret (starts with whsec_, copied from the Resend dashboard). Empty: the webhook
# endpoint POST /api/webhooks/resend answers 404 and delivery reports are not recorded.
RESEND_WEBHOOK_SECRET=

# --- Admin panel ---
# Off unless true. When true the backend refuses to start without working email (MAIL_ENABLED=true and
# RESEND_API_KEY): the panel opens only with an emailed code. The admin account is set by hand in the database.
APP_ADMIN_ENABLED=false
# Admin session window in minutes (Continue adds another) and the absolute cap in hours from the email code
APP_ADMIN_SESSION_MINUTES=30
APP_ADMIN_SESSION_MAX_HOURS=8
# Optional: a read-only mount of the backup folder inside the container (e.g. /backups). Empty: "unknown"
APP_ADMIN_BACKUP_DIR=
# Whose free disk space System status shows (inside the container)
APP_ADMIN_DISK_PATH=/
# Send email from the admin panel: the sender (on a domain verified in Resend) and where replies go (your inbox).
# Empty sender: Send email is off (the app still starts).
APP_ADMIN_MAIL_FROM=
APP_ADMIN_MAIL_REPLY_TO=
# Admin audit log rows older than this many days are deleted once a day
APP_AUDIT_RETENTION_DAYS=730
# Where the contact form (roomtrack.app/contact) sends messages; replies go to the visitor. Stays on the server,
# never in the code or the website. Empty: the form says it is not available.
CONTACT_TO=

# --- API documentation (Swagger UI at /swagger-ui/index.html, spec at /v3/api-docs). Off unless true ---
APP_DOCS_ENABLED=false
APP_DOCS_SERVER_URL=https://api.roomtrack.app

# --- "Try the demo": each visitor gets a private sample account, deleted after 1 hour. Off unless true ---
APP_DEMO_ENABLED=false
