# Netlify response headers (copied into dist/ by Vite). Build settings stay in the Netlify UI; redirects in _redirects.

# The service worker must always be checked with the server, or a new deploy can't reach installed apps.
/sw.js
  Cache-Control: no-cache
  Content-Type: application/javascript; charset=utf-8

# index.html is the app shell the service worker compares against; always revalidate.
/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache

# Built files have a content hash in their name: they never change, cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
